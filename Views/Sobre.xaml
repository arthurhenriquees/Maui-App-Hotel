<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiAppHotel.Views.Sobre"
    Title="Sobre">

    <ScrollView>

        <VerticalStackLayout Padding="25" Spacing="20">

            <Label
                Text="Hotel Paraíso Vl. Clara"
                FontFamily="IndieFlower"
                FontSize="45"
                TextColor="{StaticResource Primary}"
                HorizontalTextAlignment="Center"
                Margin="0,20,0,0" />

            <Label
                Text="Sobre o Aplicativo"
                FontSize="24"
                FontAttributes="Bold"
                HorizontalTextAlignment="Center" />

            <Border
                StrokeShape="RoundRectangle 10"
                BackgroundColor="{StaticResource Gray600}"
                Padding="20">

                <VerticalStackLayout Spacing="15">

                    <Label
                        Text="Bem-vindo ao nosso aplicativo de hotelaria! Aqui você pode encontrar informações sobre o nosso hotel e os serviços disponíveis."
                        FontSize="22"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center" />

                    <Label
                        Text="Este aplicativo foi desenvolvido para facilitar a contratação de hospedagens, permitindo selecionar a acomodação, informar a quantidade de hóspedes e escolher as datas de entrada e saída."
                        FontSize="16"
                        HorizontalTextAlignment="Center" />

                </VerticalStackLayout>

            </Border>

            <Border
                StrokeShape="RoundRectangle 15"
                BackgroundColor="{StaticResource Gray600}"
                Padding="20">

                <VerticalStackLayout Spacing="12">

                    <Label
                        Text="Informações do desenvolvedor:"
                        FontSize="20"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center" />

                    <Label
                        Text="Desenvolvedor: Arthur Henrique."
                        FontSize="16" />

                    <Label
                        Text="Tecnologias utilizadas: .NET MAUI, C# e XAML."
                        FontSize="16" />

                    <Label
                        Text="Instituição: ETEC"
                        FontSize="16" />

                    <Label
                        Text="Ano de desenvolvimento: 2026"
                        FontSize="16" />

                </VerticalStackLayout>

            </Border>

            <Label
                Text="Obrigado por utilizar nosso aplicativo!"
                FontSize="16"
                HorizontalTextAlignment="Center"
                Margin="0,10,0,20" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
