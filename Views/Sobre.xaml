<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    x:Class="MauiAppHotel.Views.Sobre"
    Title="Sobre">

    <ScrollView>

        <VerticalStackLayout Padding="20" Spacing="18">

            <Label
                Text="Hotel Paraíso Vl. Clara"
                FontFamily="IndieFlower"
                FontSize="38"
                FontAttributes="Bold"
                TextColor="{StaticResource Primary}"
                HorizontalTextAlignment="Center"
                Margin="0,25,0,0" />

            <Label
                Text="Sobre o Aplicativo"
                FontSize="23"
                FontAttributes="Bold"
                TextColor="{StaticResource Primary}"
                HorizontalTextAlignment="Center" />

            <Border
                StrokeShape="RoundRectangle 20"
                BackgroundColor="White"
                Stroke="{StaticResource Primary}"
                StrokeThickness="1"
                Padding="20">

                <VerticalStackLayout Spacing="12">

                    <Label
                        Text="Bem-vindo ao nosso aplicativo de hotelaria! Aqui você pode encontrar informações sobre o nosso hotel e os serviços disponíveis."
                        FontSize="19"
                        FontAttributes="Bold"
                        HorizontalTextAlignment="Center" 
                        TextColor="#40364D"/>

                    <Label
                        Text="Este aplicativo foi desenvolvido para facilitar a contratação de hospedagens, permitindo selecionar a acomodação, informar a quantidade de hóspedes e escolher as datas de entrada e saída."
                        FontSize="16"
                        HorizontalTextAlignment="Center" 
                        TextColor="#40364D"/>

                </VerticalStackLayout>

            </Border>

            <Border
                StrokeShape="RoundRectangle 20"
                BackgroundColor="White"
                Stroke="{StaticResource Primary}"
                StrokeThickness="1"
                Padding="20">

                <VerticalStackLayout Spacing="12">

                    <Label
                        Text="Informações do desenvolvedor"
                        FontSize="20"
                        FontAttributes="Bold"
                        TextColor="{StaticResource Primary}"
                        HorizontalTextAlignment="Center" />

                    <Label
                        Text="Desenvolvedor: Arthur Henrique."
                        FontSize="16"
                        TextColor="#40364D" />
                        

                    <Label
                        Text="Tecnologias utilizadas: .NET MAUI, C# e XAML."
                        FontSize="16" 
                        TextColor="#40364D"/>

                    <Label
                        Text="Instituição: ETEC"
                        FontSize="16" 
                        TextColor="#40364D"/>

                    <Label
                        Text="Ano de desenvolvimento: 2026"
                        FontSize="16" 
                        TextColor="#40364D"/>

                </VerticalStackLayout>

            </Border>

            <Label
                Text="Obrigado por escolher o Hotel Paraíso Vl. Clara!"
                FontFamily="IndieFlower"
                FontSize="21"
                TextColor="{StaticResource Primary}"
                HorizontalTextAlignment="Center"
                Margin="0,10,0,25" />

        </VerticalStackLayout>

    </ScrollView>

</ContentPage>
